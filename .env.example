# Copy to .env and fill in. .env is git-ignored; never commit real values.
DISCORD_WEBHOOK_URL=
# Optional overrides (defaults in src/meeting_scribe/config.py)
# GCP_PROJECT=dory-personal-assistant
# AUDIO_BUCKET=dory-personal-assistant-audio
# USE_PUBSUB=false
# STORE=memory

# Dory (Discord receipts + expense Q&A bot). All keys are DORY_-prefixed.
DORY_DISCORD_TOKEN=
# Voice helper bots "Dory · 2", "Dory · 3" (comma-separated tokens; see README "Voice helpers").
# Put the tokens here with an editor; never paste them in chat or logs.
# DORY_VOICE_TOKENS=
# DORY_AUTO_JOIN_MIN_HUMANS=1   # join a voice channel once this many people are in it
# DORY_AUTO_JOIN_DELAY_SECONDS=0   # optional stability wait before auto-joining (0 = immediately)
# DORY_AUTO_JOIN_COOLDOWN_MINUTES=60   # no auto-join in a channel where someone told Dory to leave
# Local defaults applied to every guild; customers normally need none of these (channels named
# "ใบเสร็จ"/"receipt" work out of the box, the rest is set per guild in /hub).
# DORY_RECEIPT_CHANNEL_IDS=    # comma-separated channel ids
# DORY_ASK_CHANNEL_IDS=        # channels where every message is a question
# DORY_EXEC_ROLE_NAMES=ผู้บริหาร,Executive
# DORY_EXEC_USER_IDS=          # comma-separated user ids
# DORY_DIGEST_TIME=18:00       # HH:MM in DORY_TZ
# DORY_DIGEST_CHANNEL_ID=
# DORY_HUB_URL=https://meeting-scribe-638191001920.asia-southeast1.run.app   # target of /ตั้งค่า links
# DORY_DB_PATH=./data/ledger.db
# DORY_GCP_PROJECT=dory-personal-assistant
# DORY_GEMINI_LOCATION=global
# DORY_GEMINI_MODEL=gemini-3.5-flash
# DORY_TZ=Asia/Bangkok
# DORY_STORE=
# DORY_FIRESTORE_COLLECTION=
# DORY_RECEIPT_BUCKET=
# DORY_GEMINI_CLI_PATH=
# DORY_DEEP_TASK_TIMEOUT=
# DORY_DEEP_TASK_MODEL=
# DORY_GATE_MODEL=gemini-3.5-flash-lite   # cheap yes/no gate for call/join modes; also memory summaries and image descriptions
# Team memory (see README): default retention for guilds that did not set one, summary triggers, import caps
# DORY_MEMORY_RETENTION_DAYS=90
# DORY_MEMORY_UPDATE_EVERY=30
# DORY_MEMORY_QUIET_MINUTES=20
# DORY_MEMORY_IMPORT_GUILD_CAP=20000
# DORY_MEMORY_IMPORT_IMAGES_PER_DAY=300
# DORY_MEMORY_IMPORT_SUMMARIES_PER_DAY=200
# Meaning-based memory search (embeddings of summary items). Empty model = keyword-only search.
# DORY_EMBED_MODEL=gemini-embedding-001
# DORY_EMBED_DIM=256
# DORY_EMBED_LOCATION=         # empty = DORY_GEMINI_LOCATION

# Concept studio (dory.concept): AI concept images per guild per day (own counter, separate from the
# promo kits; 0 = off). The image model is DORY_PROMO_IMAGE_MODEL.
# DORY_CONCEPT_IMAGES_PER_DAY=20
# DORY_CONCEPT_IMAGE_SIZE=1K

# Dory command center (/hub). Empty client id = every /api/hub call returns 503.
# HUB_GOOGLE_CLIENT_ID=         # OAuth 2.0 Web client id (public). Authorized origins: Cloud Run URL, http://localhost:8080
# HUB_ADMIN_EMAILS=             # optional super admins (comma-separated Google accounts) who see every guild
# DORY_DISCORD_CLIENT_ID=      # public Discord application id; builds the Add-to-Discord link
# DORY_GUILD_COLLECTION=dory_guilds   # Firestore: one settings doc per guild (hub and bot must match)

# Flights (optional): without a key flight_status uses a Google Search grounded lookup and track_flight is off
# DORY_AERODATABOX_KEY=        # RapidAPI key for AeroDataBox
# DORY_AVIATIONSTACK_KEY=

# Dory on Slack, LINE, Telegram and WhatsApp (separate process: python -m dory.platforms). Each platform starts only
# when all of its secrets are set. See docs/platforms/.
# DORY_SLACK_BOT_TOKEN=xoxb-...        # secret
# DORY_SLACK_APP_TOKEN=xapp-...        # secret (Socket Mode, scope connections:write)
# DORY_SLACK_EXEC_USER_IDS=U0123,U0456 # extra executives; workspace owners/admins always count
# DORY_SLACK_IMPORT=true               # import channel history within the retention window
# DORY_LINE_CHANNEL_SECRET=            # secret
# DORY_LINE_CHANNEL_ACCESS_TOKEN=      # secret
# DORY_LINE_EXEC_USER_IDS=U...         # LINE user ids of executives
# DORY_LINE_HOST=127.0.0.1             # 0.0.0.0 in a container
# DORY_LINE_PORT=8091
# DORY_TELEGRAM_BOT_TOKEN=123456:ABC...  # secret (from @BotFather; long polling, no public URL)
# DORY_TELEGRAM_EXEC_USER_IDS=123456789 # numeric Telegram user ids of executives (group admins do not count)
# DORY_WHATSAPP_ACCESS_TOKEN=EAAG...   # secret (system user token; a test token lasts 24 h)
# DORY_WHATSAPP_APP_SECRET=            # secret (App settings > Basic; signs the webhook)
# DORY_WHATSAPP_VERIFY_TOKEN=          # secret, any long random string, for the webhook handshake
# DORY_WHATSAPP_PHONE_NUMBER_ID=       # the business number's id (WhatsApp > API Setup)
# DORY_WHATSAPP_EXEC_NUMBERS=66811112222 # wa_ids (digits) of executives
# DORY_WHATSAPP_API_VERSION=v26.0
# DORY_WHATSAPP_HOST=127.0.0.1         # 0.0.0.0 in a container
# DORY_WHATSAPP_PORT=8092

