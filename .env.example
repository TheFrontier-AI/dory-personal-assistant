# Copy to .env and fill in. .env is git-ignored; never commit real values.
DISCORD_WEBHOOK_URL=
# Optional overrides (defaults in src/meeting_scribe/config.py)
# GCP_PROJECT=dory-personal-assistant
# AUDIO_BUCKET=dory-personal-assistant-audio
# USE_PUBSUB=false
# STORE=memory

# Dory (Discord receipts + expense Q&A bot). All keys are DORY_-prefixed.
DORY_DISCORD_TOKEN=
# Local defaults applied to every guild; customers normally need none of these (channels named
# "ใบเสร็จ"/"receipt" work out of the box, the rest is set per guild in /hub).
# DORY_RECEIPT_CHANNEL_IDS=    # comma-separated channel ids
# DORY_ASK_CHANNEL_IDS=        # channels where every message is a question
# DORY_EXEC_ROLE_NAMES=ผู้บริหาร,Executive
# DORY_EXEC_USER_IDS=          # comma-separated user ids
# DORY_DIGEST_TIME=18:00       # HH:MM in DORY_TZ
# DORY_DIGEST_CHANNEL_ID=
# DORY_HUB_URL=https://meeting-scribe-638191001920.asia-southeast1.run.app   # target of /ตั้งค่า links
# DORY_DB_PATH=./data/ledger.db
# DORY_GCP_PROJECT=dory-personal-assistant
# DORY_GEMINI_LOCATION=global
# DORY_GEMINI_MODEL=gemini-3.5-flash
# DORY_TZ=Asia/Bangkok
# DORY_STORE=
# DORY_FIRESTORE_COLLECTION=
# DORY_RECEIPT_BUCKET=
# DORY_GEMINI_CLI_PATH=
# DORY_DEEP_TASK_TIMEOUT=
# DORY_DEEP_TASK_MODEL=
# DORY_GATE_MODEL=gemini-3.5-flash-lite   # cheap yes/no gate for call/join modes

# Dory command center (/hub). Empty client id = every /api/hub call returns 503.
# HUB_GOOGLE_CLIENT_ID=         # OAuth 2.0 Web client id (public). Authorized origins: Cloud Run URL, http://localhost:8080
# HUB_ADMIN_EMAILS=             # optional super admins (comma-separated Google accounts) who see every guild
# DORY_DISCORD_CLIENT_ID=      # public Discord application id; builds the Add-to-Discord link
# DORY_GUILD_COLLECTION=dory_guilds   # Firestore: one settings doc per guild (hub and bot must match)
