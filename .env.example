# GCP_PROJECT=dory-personal-assistant
# AUDIO_BUCKET=dory-personal-assistant-audio
# USE_PUBSUB=false
# STORE=memory

# Dory (Discord receipts + expense Q&A bot). All keys are DORY_-prefixed.
DORY_DISCORD_TOKEN=
DORY_RECEIPT_CHANNEL_IDS=      # comma-separated channel ids
DORY_ASK_CHANNEL_IDS=          # channels where every message is a question
